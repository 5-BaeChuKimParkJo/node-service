datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
  output        = "../generated"
}

model Test {
  testId String @id @default(uuid()) @db.Uuid
  title  String
  value  BigInt
}

enum AuctionStatus {
  visible // 공개
  hidden // 일시 중지/숨김
  cancelled // 취소됨
}

enum ProductCondition {
  unopened // 미개봉
  new // 새상품 (개봉은 했지만 미사용 포함 가능)
  used // 사용감 있음
}

model Auctions {
  auctionId          BigInt           @id @default(autoincrement())
  auctionUuid        String           @unique @default(uuid()) @db.Uuid
  categoryId         Int?
  title              String
  description        String
  minimumBid         BigInt
  currentBid         BigInt
  currentBidderUuid  String?
  startAt            DateTime         @db.Timestamptz(6)
  endAt              DateTime         @db.Timestamptz(6)
  isDirectDeal       Boolean
  directDealLocation String?
  status             AuctionStatus
  productCondition   ProductCondition
  viewCount          BigInt           @default(0)
  thumbnailKey       String
  soldAt             DateTime?        @db.Timestamptz(6)
  checkoutLockedAt   DateTime?        @db.Timestamptz(6)
  demoTemplateUuid   String?          @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  version   Int       @default(0)

  sellerUuid String @db.Uuid
  tagIds     Int[]  @default([])

  auctionBidders AuctionBidders[]
  auctionImages  AuctionImages[]
  purchase       AuctionPurchase?

  @@index([demoTemplateUuid, endAt])
}

enum AuctionPurchaseStatus {
  AWAITING_PAYMENT
  PAID
  CANCELED
}

enum AuctionPaymentAttemptStatus {
  READY
  CONFIRMING
  UNKNOWN
  WAITING_FOR_DEPOSIT
  DONE
  CANCELING
  CANCELED
  ABORTED
  EXPIRED
}

model AuctionPurchase {
  purchaseUuid String @id @default(uuid()) @db.Uuid
  auctionUuid String @unique @db.Uuid
  buyerUuid String @db.Uuid
  sellerUuid String @db.Uuid
  amount BigInt
  orderName String
  customerKey String @unique @db.Uuid
  status AuctionPurchaseStatus @default(AWAITING_PAYMENT)
  paidAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  auction Auctions @relation(fields: [auctionUuid], references: [auctionUuid])
  attempts AuctionPaymentAttempt[]
}

model AuctionPaymentAttempt {
  orderId String @id
  purchaseUuid String @db.Uuid
  attemptNumber Int
  paymentKey String? @unique
  confirmIdempotencyKey String @unique @db.Uuid
  cancelIdempotencyKey String @unique @db.Uuid
  status AuctionPaymentAttemptStatus @default(READY)
  method String?
  approvedAt DateTime? @db.Timestamptz(6)
  confirmRequestedAt DateTime? @db.Timestamptz(6)
  cancelRequestedAt DateTime? @db.Timestamptz(6)
  operationLeaseUntil DateTime? @db.Timestamptz(6)
  operationLeaseToken String? @db.Uuid
  cancelReason String?
  cancelActor String?
  errorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  purchase AuctionPurchase @relation(fields: [purchaseUuid], references: [purchaseUuid])

  @@unique([purchaseUuid, attemptNumber])
}

model AuctionImages {
  auctionImageId BigInt @id @default(autoincrement())
  key            String
  order          Int

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  version   Int       @default(0)

  auctionId BigInt
  auction   Auctions @relation(fields: [auctionId], references: [auctionId])

  @@index([auctionId])
}

model AuctionBidders {
  auctionBidderId   BigInt @id @default(autoincrement())
  auctionBidderUuid String @unique @default(uuid()) @db.Uuid
  bidAmount         BigInt

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  version   Int       @default(0)

  bidderUuid String @db.Uuid

  auctionId BigInt
  auction   Auctions @relation(fields: [auctionId], references: [auctionId])

  @@index([auctionId])
  @@index([createdAt, auctionId, bidderUuid])
}

model Outbox {
  id            String   @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  op            String   @db.Char(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([aggregateType, aggregateId])
}

model AuctionViewed {
  auctionViewedId BigInt @id @default(autoincrement())
  auctionUuid     String @db.Uuid
  viewerUuid      String @db.Uuid
  viewedAt        DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([viewedAt, auctionUuid, viewerUuid])
}

model Category {
  categoryId Int     @id
  name       String  @unique
  description String
  imageUrl   String?
}

model Tag {
  tagId Int    @id
  name  String @unique
}

model AuctionAdminActions {
  auctionAdminActionId String   @id @default(uuid()) @db.Uuid
  auctionUuid          String   @db.Uuid
  actor                String
  action               String
  reason               String
  previousStatus       String
  nextStatus           String
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  @@index([auctionUuid, createdAt])
}
